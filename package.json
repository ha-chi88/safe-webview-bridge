{
  "name": "safe-webview-bridge",
  "version": "2.0.0",
  "description": "A typed, schema-agnostic bridge between the web and React Native WebView.",
  "keywords": [
    "arktype",
    "effect",
    "react-native",
    "standard-schema",
    "typescript",
    "valibot",
    "webview",
    "zod"
  ],
  "license": "MIT",
  "author": "ha-chi88",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ha-chi88/safe-webview-bridge.git"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.js",
      "default": "./dist/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "vitest run",
    "test:security": "vitest run test/security.test.ts",
    "audit:production": "pnpm audit --prod",
    "test:browser": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:package",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.7",
    "@playwright/test": "^1.64.1",
    "@react-native/babel-preset": "^0.88.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "arktype": "^2.2.9",
    "effect": "^4.0.5",
    "esbuild": "^0.28.2",
    "metro": "^0.87.1",
    "metro-config": "^0.87.1",
    "metro-runtime": "^0.87.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-webview": "^14.0.1",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.14.0",
  "pnpm": {
    "overrides": {
      "yaml@<2.8.3": "^2.9.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
